<Window x:Class="SubGuard.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SubGuard Desktop"
        Height="800"
        Width="1280"
        MinHeight="680"
        MinWidth="1040"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="Segoe UI"
        FontSize="14">
    <Window.Resources />

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.RowSpan="3" Padding="12,16" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,0,0,24">
                    <TextBlock Text="SUBGUARD" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Pay application control" Style="{StaticResource MutedText}" FontSize="12" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,12,0,0">
                    <ContentControl Content="Local data" Style="{StaticResource StatusChip}" />
                </StackPanel>
                <ListBox x:Name="NavigationList"
                         AutomationProperties.Name="Main navigation"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemContainerStyle="{StaticResource NavItem}"
                         KeyboardNavigation.TabNavigation="Once"
                         SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                    <ListBoxItem Content="Projects" ToolTip="Ctrl+1" AutomationProperties.AccessKey="Ctrl+1" />
                    <ListBoxItem Content="Subcontracts" ToolTip="Ctrl+2" AutomationProperties.AccessKey="Ctrl+2" />
                    <ListBoxItem Content="Pay applications" ToolTip="Ctrl+3" AutomationProperties.AccessKey="Ctrl+3" />
                    <ListBoxItem Content="Compliance" ToolTip="Ctrl+4" AutomationProperties.AccessKey="Ctrl+4" />
                    <ListBoxItem Content="Audit history" ToolTip="Ctrl+5" AutomationProperties.AccessKey="Ctrl+5" />
                </ListBox>
            </DockPanel>
        </Border>

        <StackPanel Grid.Column="1" Grid.Row="0" Margin="24,16,24,8">
            <TextBlock Text="{Binding ContextLine}" Style="{StaticResource MutedText}" FontSize="12"
                       AutomationProperties.Name="Current context" />
            <TextBlock Text="{Binding PageName}" Style="{StaticResource PageTitle}" Margin="0,4,0,0" />
        </StackPanel>

        <TabControl Grid.Column="1" Grid.Row="1" Margin="24,8,24,0" Background="Transparent" BorderThickness="0"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    KeyboardNavigation.TabNavigation="Local">
            <TabControl.ItemContainerStyle>
                <StaticResource ResourceKey="HiddenTabItem" />
            </TabControl.ItemContainerStyle>
            <TabItem Header="Projects">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" MinWidth="340" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Search" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ProjectSearchBox" Width="260" Margin="0"
                                             AutomationProperties.Name="Search projects"
                                             Text="{Binding ProjectSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Width="130" Margin="0" AutomationProperties.Name="Project status filter"
                                              ItemsSource="{Binding ProjectStatusFilters}"
                                              SelectedItem="{Binding ProjectStatusFilter, Mode=TwoWay}" />
                                </StackPanel>
                                <Button Content="Clear filters" VerticalAlignment="Bottom" Command="{Binding ClearProjectFiltersCommand}" />
                            </StackPanel>
                            <Border DockPanel.Dock="Top" Background="{DynamicResource FailBgBrush}" BorderBrush="{DynamicResource FailBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,12"
                                    Visibility="{Binding ProjectsError, Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="{Binding ProjectsError}" Foreground="{DynamicResource FailBrush}" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Assertive" />
                            </Border>
                            <Grid>
                                <DataGrid ItemsSource="{Binding ProjectsView}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                          CanUserSortColumns="True" AutomationProperties.Name="Projects">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Project no." Binding="{Binding ProjectNumber}" SortMemberPath="ProjectNumber" Width="*" />
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" SortMemberPath="Name" Width="2*" />
                                        <DataGridTextColumn Header="Owner" Binding="{Binding OwnerName}" SortMemberPath="OwnerName" Width="1.3*" />
                                        <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ContentControl Content="{Binding Status}" Style="{StaticResource StatusChip}" Margin="0,2" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="{Binding ProjectsEmptyMessage}" Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Margin="24,40,24,0" IsHitTestVisible="False"
                                           Visibility="{Binding ProjectsEmptyMessage, Converter={StaticResource StringToVisibility}}" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Project details" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Project number" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ProjectNumber, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Project name" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Owner" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ProjectOwner, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ProjectStatuses}" SelectedItem="{Binding ProjectStatus, Mode=TwoWay}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                                    <Button Content="New project" Command="{Binding NewProjectCommand}" />
                                    <Button Content="Save" Command="{Binding SaveProjectCommand}" Style="{StaticResource PrimaryButton}" />
                                    <Button Content="Delete" Command="{Binding DeleteProjectCommand}" Style="{StaticResource DangerButton}" />
                                </StackPanel>
                                <TextBlock Text="Subcontracts in this project" Style="{StaticResource SectionTitle}" />
                                <DataGrid ItemsSource="{Binding ProjectSubcontracts}" MaxHeight="220"
                                          AutomationProperties.Name="Subcontracts in this project"
                                          SelectedItem="{Binding SelectedSubcontractRow, Mode=TwoWay}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Subcontract" Binding="{Binding Name}" Width="*" />
                                        <DataGridTemplateColumn Header="Compliance" Width="130"
                                                                SortMemberPath="ComplianceStatus">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ContentControl Content="{Binding ComplianceStatus}" Style="{StaticResource StatusChip}" Margin="0,2" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="Select a project to list its subcontracts. Assign a subcontract to a project on the Subcontracts page." />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Subcontracts">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="360" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Subcontracts" Style="{StaticResource SectionTitle}" />
                            <Grid>
                                <DataGrid ItemsSource="{Binding SubcontractRows}" SelectedItem="{Binding SelectedSubcontractRow, Mode=TwoWay}"
                                          AutomationProperties.Name="Subcontracts">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Subcontractor" Binding="{Binding Name}" Width="1.6*" />
                                        <DataGridTextColumn Header="Project" Binding="{Binding ProjectLabel}" Width="*" />
                                        <DataGridTemplateColumn Header="Compliance" SortMemberPath="ComplianceStatus" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ContentControl Content="{Binding ComplianceStatus}" Style="{StaticResource StatusChip}" Margin="0,2" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,8,16,16">
                        <TabControl BorderThickness="0" Background="Transparent">
                            <TabItem Header="Details">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Company / subcontractor name" Style="{StaticResource FieldLabel}" />
                                                <TextBox Text="{Binding SubcontractorName, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Project" Style="{StaticResource FieldLabel}" />
                                                <ComboBox ItemsSource="{Binding ProjectChoices}" DisplayMemberPath="Label"
                                                          SelectedValuePath="Id" SelectedValue="{Binding SubcontractProjectId, Mode=TwoWay}" />
                                                <TextBlock Text="Contact person" Style="{StaticResource FieldLabel}" />
                                                <TextBox Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
                                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Phone" Style="{StaticResource FieldLabel}" />
                                                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Original subcontract value" Style="{StaticResource FieldLabel}" />
                                                <TextBox Text="{Binding OriginalContractValueText, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Approved change orders" Style="{StaticResource FieldLabel}" />
                                                <TextBox Text="{Binding ApprovedChangeOrderTotalText, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Retainage percent" Style="{StaticResource FieldLabel}" />
                                                <TextBox Text="{Binding RetainagePercentText, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="New" Command="{Binding NewSubcontractorCommand}" />
                                            <Button Content="Save" Command="{Binding SaveSubcontractorCommand}" Style="{StaticResource PrimaryButton}" />
                                            <Button Content="Delete" Command="{Binding DeleteSubcontractorCommand}" Style="{StaticResource DangerButton}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Schedule of values">
                                <DockPanel Margin="0,16,0,0">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button Content="Add line" Command="{Binding AddScheduleLineCommand}" />
                                        <Button Content="Remove line" Command="{Binding RemoveScheduleLineCommand}" />
                                        <Button Content="Save schedule" Command="{Binding SaveScheduleCommand}" Style="{StaticResource PrimaryButton}" />
                                    </StackPanel>
                                    <DataGrid ItemsSource="{Binding ScheduleLines}"
                                              SelectedItem="{Binding SelectedScheduleLine, Mode=TwoWay}"
                                              IsReadOnly="False" AutomationProperties.Name="Schedule of values">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Line" Binding="{Binding LineNumber, UpdateSourceTrigger=PropertyChanged}" Width="75" />
                                            <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                            <DataGridTextColumn Header="Scheduled value" Binding="{Binding ScheduledValue, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Width="*" />
                                            <DataGridTextColumn Header="Previously billed" Binding="{Binding PreviouslyBilledSnapshot, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Pay applications">
                                <DataGrid Margin="0,16,0,0" ItemsSource="{Binding SubcontractPayApplications}"
                                          AutomationProperties.Name="Pay applications for this subcontract">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Application" Binding="{Binding ApplicationNumber}" Width="*" />
                                        <DataGridTextColumn Header="Period end" Binding="{Binding PeriodEnd, StringFormat={}{0:yyyy-MM-dd}}" Width="*" />
                                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="*" />
                                        <DataGridTemplateColumn Header="Status" Width="170" SortMemberPath="Status">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ContentControl Content="{Binding Status}" Style="{StaticResource StatusChip}" Margin="0,2" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Compliance">
                                <DockPanel Margin="0,16,0,0">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Overall:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource MutedText}" />
                                        <ContentControl Content="{Binding SubcontractComplianceStatus}" Style="{StaticResource StatusChip}" />
                                    </StackPanel>
                                    <DataGrid ItemsSource="{Binding SubcontractCompliance}" AutomationProperties.Name="Compliance evidence for this subcontract">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" />
                                            <DataGridTextColumn Header="Document number" Binding="{Binding DocumentNumber}" Width="1.4*" />
                                            <DataGridTextColumn Header="Expires" Binding="{Binding ExpiryDate, StringFormat={}{0:yyyy-MM-dd}}" Width="*" />
                                            <DataGridTemplateColumn Header="Today" Width="150" SortMemberPath="CurrentDayStatus">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ContentControl Content="{Binding CurrentDayStatus}" Style="{StaticResource StatusChip}" Margin="0,2" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Pay applications">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.1*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,12">
                        <DataGrid ItemsSource="{Binding PayApplications}" SelectedItem="{Binding SelectedPayApplication, Mode=TwoWay}"
                                  AutomationProperties.Name="Pay applications">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Application" Binding="{Binding ApplicationNumber}" Width="*" />
                                <DataGridTextColumn Header="Subcontractor" Binding="{Binding SubcontractorName}" Width="1.5*" />
                                <DataGridTextColumn Header="Period end" Binding="{Binding PeriodEnd, StringFormat={}{0:yyyy-MM-dd}}" Width="*" />
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="*" />
                                <DataGridTemplateColumn Header="Status" Width="170" SortMemberPath="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding Status}" Style="{StaticResource StatusChip}" Margin="0,2" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Pay-application details" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Application number" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ApplicationNumber, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Subcontractor" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Subcontractors}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedApplicationSubcontractor, Mode=TwoWay}" />
                                <TextBlock Text="Period start" Style="{StaticResource FieldLabel}" />
                                <DatePicker SelectedDate="{Binding PeriodStart, Mode=TwoWay}" />
                                <TextBlock Text="Period end" Style="{StaticResource FieldLabel}" />
                                <DatePicker SelectedDate="{Binding PeriodEnd, Mode=TwoWay}" />
                                <TextBlock Text="Claim lines" Style="{StaticResource FieldLabel}" />
                                <DataGrid ItemsSource="{Binding ClaimLines}" Height="210" MinHeight="130" IsReadOnly="False" CanUserAddRows="False" Margin="0,0,0,8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" IsReadOnly="True" Width="50" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" IsReadOnly="True" Width="1.5*" />
                                        <DataGridTextColumn Header="Scheduled" Binding="{Binding ScheduledValue, StringFormat={}{0:N2}}" IsReadOnly="True" Width="*" />
                                        <DataGridTextColumn Header="Previously billed" Binding="{Binding PreviouslyBilled, StringFormat={}{0:N2}}" IsReadOnly="True" Width="*" />
                                        <DataGridTextColumn Header="Remaining" Binding="{Binding Remaining, StringFormat={}{0:N2}}" IsReadOnly="True" Width="*" />
                                        <DataGridTextColumn Header="This claim" Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Claim total: " FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ClaimTotal, StringFormat={}{0:N2}}" VerticalAlignment="Center" />
                                    <Button Content="Refresh snapshot" Command="{Binding RefreshClaimSnapshotCommand}" Margin="16,0,0,0" />
                                </StackPanel>
                                <Border Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="12" Margin="0,0,0,12" AutomationProperties.Name="Validation panel">
                                    <StackPanel>
                                        <TextBlock Text="Validation" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding ValidationRows}" AutomationProperties.LiveSetting="Polite">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,4">
                                                        <ContentControl DockPanel.Dock="Left" Content="{Binding State}" Style="{StaticResource StatusChip}" Width="70" />
                                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="62" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="New" Command="{Binding NewPayApplicationCommand}" />
                                    <Button Content="Save" Command="{Binding SavePayApplicationCommand}" Style="{StaticResource PrimaryButton}" />
                                    <Button Content="Delete" Command="{Binding DeletePayApplicationCommand}" Style="{StaticResource DangerButton}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Compliance">
                <Grid Margin="0,0,0,8" DataContext="{Binding ApprovalWorkflow}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Margin="0" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Pay application" VerticalAlignment="Center" Style="{StaticResource MutedText}" Margin="0,0,8,0" />
                            <ComboBox Width="260" Margin="0,0,12,0"
                                      ItemsSource="{Binding Applications}"
                                      SelectedItem="{Binding SelectedApplication, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ApplicationNumber}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ContentControl Content="{Binding SelectedApplication.Status}" Style="{StaticResource StatusChip}" Margin="0,0,16,0" />
                            <Button Content="Submit" Command="{Binding SubmitCommand}" Style="{StaticResource PrimaryButton}" />
                            <Button Content="Pass R1" Command="{Binding CompleteComplianceReviewCommand}" />
                            <Button Content="Pass R1 + R2" Command="{Binding CompleteWaiverReviewCommand}" />
                            <Button Content="Approve (R1–R5)" Command="{Binding ApproveCommand}" Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Rules}" Height="178" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rule" Binding="{Binding RuleCode}" Width="55" />
                            <DataGridTemplateColumn Header="State" Width="130" SortMemberPath="State">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding State}" Style="{StaticResource StatusChip}" Margin="0,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="1.1*" />
                            <DataGridTextColumn Header="Comparison" Binding="{Binding Comparison}" Width="1.7*" />
                            <DataGridTextColumn Header="Result / candidate details" Binding="{Binding DetailText}" Width="1.8*" />
                            <DataGridTemplateColumn Header="Go to" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Open"
                                                Command="{Binding DataContext.GoToRuleCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                CommandParameter="{Binding RuleCode}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TabControl Grid.Row="2"
                                SelectedIndex="{Binding SelectedEvidenceTabIndex, Mode=TwoWay}">
                        <TabItem Header="Compliance evidence">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="0.8*" />
                                </Grid.ColumnDefinitions>
                                <DataGrid Grid.Column="0" ItemsSource="{Binding ComplianceRecords}"
                                          SelectedItem="{Binding SelectedComplianceRecord, Mode=TwoWay}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" />
                                        <DataGridTextColumn Header="Document number" Binding="{Binding DocumentNumber}" Width="1.5*" />
                                        <DataGridTextColumn Header="Expires" Binding="{Binding ExpiryDate, StringFormat={}{0:yyyy-MM-dd}}" Width="*" />
                                        <DataGridTemplateColumn Header="Today" Width="150" SortMemberPath="CurrentDayStatus">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ContentControl Content="{Binding CurrentDayStatus}" Style="{StaticResource StatusChip}" Margin="0,2" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Evidence details" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <TextBlock Text="Type" Foreground="{StaticResource MutedBrush}" />
                                        <ComboBox ItemsSource="{Binding ComplianceTypes}" SelectedItem="{Binding ComplianceType}" />
                                        <TextBlock Text="Document number" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Expiry date" Foreground="{StaticResource MutedBrush}" />
                                        <DatePicker SelectedDate="{Binding ExpiryDate, Mode=TwoWay}" />
                                        <TextBlock Text="Linked file path" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox Text="{Binding ComplianceFilePath, UpdateSourceTrigger=PropertyChanged}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="New" Command="{Binding NewComplianceCommand}" />
                                            <Button Content="Save" Command="{Binding SaveComplianceCommand}" Style="{StaticResource PrimaryButton}" />
                                            <Button Content="Delete" Command="{Binding DeleteComplianceCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Lien waivers">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="0.8*" />
                                </Grid.ColumnDefinitions>
                                <DataGrid Grid.Column="0" ItemsSource="{Binding Waivers}"
                                          SelectedItem="{Binding SelectedWaiver, Mode=TwoWay}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="*" />
                                        <DataGridTextColumn Header="Signed at" Binding="{Binding SignedAt, StringFormat={}{0:yyyy-MM-dd}}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Waiver details" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <TextBlock Text="Type" Foreground="{StaticResource MutedBrush}" />
                                        <ComboBox ItemsSource="{Binding WaiverTypes}" SelectedItem="{Binding WaiverType}" />
                                        <TextBlock Text="Status" Foreground="{StaticResource MutedBrush}" />
                                        <ComboBox ItemsSource="{Binding WaiverStatuses}" SelectedItem="{Binding WaiverStatus}" />
                                        <TextBlock Text="Waiver amount" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox Text="{Binding WaiverAmountText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Signed date (metadata)" Foreground="{StaticResource MutedBrush}" />
                                        <DatePicker SelectedDate="{Binding WaiverSignedAt, Mode=TwoWay}" />
                                        <TextBlock Text="Linked file path (metadata)" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox Text="{Binding WaiverFilePath, UpdateSourceTrigger=PropertyChanged}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="New" Command="{Binding NewWaiverCommand}" />
                                            <Button Content="Save" Command="{Binding SaveWaiverCommand}" Style="{StaticResource PrimaryButton}" />
                                            <Button Content="Delete" Command="{Binding DeleteWaiverCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Invoices">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <DataGrid Grid.Column="0" ItemsSource="{Binding Invoices}"
                                          SelectedItem="{Binding SelectedInvoice, Mode=TwoWay}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="*" />
                                        <DataGridTextColumn Header="Derived line total" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="1.3*" />
                                        <DataGridTextColumn Header="R5" Binding="{Binding ReconciliationStatus}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="Invoice details" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <DockPanel>
                                            <TextBox Width="190" Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Text="{Binding InvoiceProvenance, UpdateSourceTrigger=PropertyChanged}" ToolTip="Provenance (manual for this milestone)" />
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button Content="Add line" Command="{Binding AddInvoiceLineCommand}" />
                                            <Button Content="Remove line" Command="{Binding RemoveInvoiceLineCommand}" />
                                            <TextBlock Text="Combined invoice line total:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="{Binding InvoiceLineTotal, StringFormat={}{0:N2}}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding InvoiceLines}"
                                              SelectedItem="{Binding SelectedInvoiceLine, Mode=TwoWay}"
                                              IsReadOnly="False" CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Line description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <DockPanel Grid.Row="2" Margin="0,8,0,0">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="R6 retainage (informational): " Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="{Binding RetainagePercent, StringFormat={}{0:N2}%}" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text=" = " Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="{Binding RetainageAmount, StringFormat={}{0:N2}}" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="New" Command="{Binding NewInvoiceCommand}" />
                                            <Button Content="Save invoice" Command="{Binding SaveInvoiceCommand}" Style="{StaticResource PrimaryButton}" />
                                            <Button Content="Delete" Command="{Binding DeleteInvoiceCommand}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                    <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" Margin="2,10,0,0" />
                </Grid>
            </TabItem>

            <TabItem Header="Audit history">
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <DataGrid ItemsSource="{Binding AuditEntries}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When (UTC)" Binding="{Binding OccurredAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="1.2*" />
                            <DataGridTextColumn Header="Record" Binding="{Binding EntityType}" Width="*" />
                            <DataGridTextColumn Header="Record ID" Binding="{Binding EntityId}" Width="*" />
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="*" />
                            <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Column="1" Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0" Padding="24,8" Margin="-24,16,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}"
                       AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Status" />
        </Border>
    </Grid>
</Window>
